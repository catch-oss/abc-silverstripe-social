{
  "name": "azt3k/abc-silverstripe-social",
  "description": "Library that adds some social media functionality to Silverstripe",
  "license": "BSD-3-Clause-Clear",
  "type": "silverstripe-vendormodule",
  "authors": [
    {
      "name": "Aaron Latham-Ilari",
      "email": "abcdigital@abcdigital.co.nz"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:catch-oss/tmhOAuth.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:catch-oss/abc-silverstripe-taggable.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:catch-oss/abc-silverstripe.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:catch-oss/facebook-php-sdk.git"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": "^8.5",
    "silverstripe/framework": "^6.0",
    "silverstripe/cms": "^6.0",
    "silverstripe/crontask": "^4.0",
    "silverstripe/vendor-plugin": "^3.0",
    "composer/installers": "^2.2",
    "azt3k/abc-silverstripe": "dev-release/6",
    "azt3k/abc-silverstripe-taggable": "dev-release/6",
    "themattharris/tmhoauth": "dev-release/6",
    "janu-software/facebook-php-sdk": "dev-release/6",
    "guzzlehttp/guzzle": "^7.4.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "silverstripe/recipe-cms": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "Azt3k\\SS\\Social\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Azt3k\\SS\\Social\\Tests\\": "tests/"
    },
    "classmap": [
      "app/src/Page.php",
      "app/src/PageController.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true,
      "silverstripe/recipe-plugin": true
    }
  },
  "extra": {
    "expose": [
      "css",
      "img",
      "js"
    ]
  }
}
